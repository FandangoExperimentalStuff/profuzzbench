GCOV_DIR='openssl-gcov'
GCOV_ROOT='.'
ENDPOINT='tcp://127.0.0.1/4433'
SETUP=''
CLEANUP=''
SUT='./apps/openssl s_server -key key.pem -cert cert.pem -4 -naccept 1 -no_anti_replay'
GCOV_COLLECT=''
KILL_SIGNAL='USR1'
EXIT_GRACE_MS='3000'
FIRST_RESPONSE_MS='100'
FOLLOW_UP_US='1000'
INIT_WAIT_US='1000000'
SEED_DIR='in-tls-replay'
