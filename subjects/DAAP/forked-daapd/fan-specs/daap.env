# Settings of daap.fan for this setup: forked-daapd without a library password serves database 1 with the playlists 1 and 2 and the six songs of MP3/ as items 1 to 6, at revision 2; each list adds one id the server does not know
DAAP_DATABASE_IDS='1,2,3'
DAAP_CONTAINER_IDS='1,2,3'
DAAP_ITEM_IDS='1,2,3,4,5,6,7'
DAAP_REVISION_IDS='1,2,3'
# bodies above 64 KiB (whole songs, 2 to 8 MB) are not parsed: the parser needs minutes for one of them
DAAP_MAX_BODY_BYTES='65536'
