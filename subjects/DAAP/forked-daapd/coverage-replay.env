GCOV_DIR='.'
GCOV_ROOT='forked-daapd-gcov'
ENDPOINT='tcp://127.0.0.1/3689'
SETUP='sudo /etc/init.d/dbus start; sudo /etc/init.d/avahi-daemon start'
CLEANUP=''
SUT='./forked-daapd-gcov/src/forked-daapd -d 0 -c ./forked-daapd.conf -f'
GCOV_COLLECT=''
KILL_SIGNAL='USR1'
EXIT_GRACE_MS='10000'
FIRST_RESPONSE_MS='100'
FOLLOW_UP_US='10000'
INIT_WAIT_US='2000000'
SEED_DIR='in-daap-replay'
