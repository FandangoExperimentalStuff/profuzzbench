# syntax=docker/dockerfile:1-labs
FROM forked-daapd

# Import environment variable to pass as parameter to make (e.g., to make parallel builds with -j)
ARG MAKE_OPT

# Compile forked-daapd for the Fandango driver: AFL instrumentation without the CRLF that forked-daapd.patch
# appends to every HTTP body
COPY --chown=ubuntu:ubuntu forked-daapd-fandango.patch ${WORKDIR}/forked-daapd-fandango.patch
RUN cd $WORKDIR && \
    git clone https://github.com/ejurgensen/forked-daapd.git forked-daapd-fandango && \
    cd forked-daapd-fandango && \
    git checkout 2ca10d9 && \
    patch -p1 < $WORKDIR/forked-daapd-fandango.patch && \
    autoreconf -i && \
    CC=$AFLNET/afl-clang-fast CFLAGS="-DSQLITE_CORE" ./configure --prefix=/usr --sysconfdir=/etc --localstatedir=/var  --disable-mpd --disable-itunes --disable-lastfm --disable-spotify --disable-verification  --disable-shared --enable-static && \
    AFL_USE_ASAN=1 make -C src/ SMARTPL2SQL.c SMARTPL.c DAAP2SQL.c DAAPLexer.c RSPLexer.c RSP2SQL.c && \
    AFL_USE_ASAN=1 make clean all $MAKE_OPT

# Set up Fandango in a Python 3.11 venv with the versions locked in uv.lock of the uv workspace
COPY --from=ghcr.io/astral-sh/uv:0.13.0 /uv /uvx /bin/
COPY --from=fandango-workspace --chown=ubuntu:ubuntu pyproject.toml uv.lock /home/ubuntu/fandango-workspace/
COPY --from=fandango-workspace --chown=ubuntu:ubuntu fandango-driver/pyproject.toml /home/ubuntu/fandango-workspace/fandango-driver/
COPY --from=fandango-workspace --chown=ubuntu:ubuntu spec-generator/pyproject.toml /home/ubuntu/fandango-workspace/spec-generator/
ENV UV_PROJECT_ENVIRONMENT=/home/ubuntu/fandango
USER ubuntu
RUN cd /home/ubuntu/fandango-workspace && \
    uv sync --frozen --no-dev --python 3.11 --package fandango-driver --no-install-workspace

# Install the Fandango driver into the venv
COPY --from=fandango-workspace --exclude=**/__pycache__ --exclude=.pytest_cache --chown=ubuntu:ubuntu fandango-driver /home/ubuntu/fandango-workspace/fandango-driver
RUN cd /home/ubuntu/fandango-workspace && \
    uv sync --frozen --no-dev --python 3.11 --package fandango-driver --no-editable

# Replace the run and coverage scripts of the base image with their Fandango versions
COPY --chown=ubuntu:ubuntu fandango-run.sh ${WORKDIR}/run
COPY --chown=ubuntu:ubuntu fandango-cov_script.sh ${WORKDIR}/cov_script

# Copy the Fandango specification of the protocol
COPY --chown=ubuntu:ubuntu fan-specs ${WORKDIR}/fan-specs
