# Settings of rtsp.fan for this setup
# testOnDemandRTSPServer 8554 (fandango-run.sh), no access control (ACCESS_CONTROL undefined)
RTSP_HOST=127.0.0.1
RTSP_PORT=8554
# Presentation the server plays: test.aac from the AFLNet sample media, one track. The video
# presentations stream interleaved frames of ~11 KB in real time, which Fandango does not parse
# fast enough to see the PLAY reply.
RTSP_MEDIA_PATH=aacAudioTest
RTSP_MEDIA_TRACK=track1
# A second served presentation for the requests with credentials; the server asks for none
RTSP_AUTH_PATH=ac3AudioTest
# The server has no RECORD; a presentation it does not serve, as in the spec's LIVE555 setup
RTSP_RECORD_PATH=rec
RTSP_RECORD_TRACK=track1
RTSP_TRANSPORT=tcp
# LIVE555 never echoes Timestamp (tolerances.json of the spec's run)
TOLERATED=timestamp-not-echoed
RTSP_REPLY_WAIT=1.0
RTSP_AUTH_REPLY_WAIT=1.0
