# Settings of rtsp.fan for this setup: testOnDemandRTSPServer on port 8554 (fandango-run.sh), no access control
RTSP_AUTHORITY=127.0.0.1:8554
# Presentations testOnDemandRTSPServer serves from the AFLNet sample media (the paths of the in-rtsp seeds)
RTSP_TARGETS=/aacAudioTest,/ac3AudioTest,/matroskaFileTest,/mp3AudioTest,/mpeg1or2AudioVideoTest,/wavAudioTest,/webmFileTest
RTSP_CONTROLS=/track1,/track2
# The server has no RECORD; a path it does not serve
RTSP_PUBLISH_TARGETS=/publish
# Deviation of LIVE555 the grammar tolerates (tolerances.json of the run)
TOLERATED=date_month_first
