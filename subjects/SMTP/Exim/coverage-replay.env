GCOV_DIR='exim-gcov'
GCOV_ROOT='.'
ENDPOINT='tcp://127.0.0.1/25'
SETUP='cp ./src/build-Linux-x86_64/exim /usr/exim/bin/exim; chmod -R a+rwX ./src/build-Linux-x86_64'
CLEANUP=''
SUT='exim -bd -d -oX 25 -oP /var/lock/exim.pid'
GCOV_COLLECT=''
KILL_SIGNAL='TERM'
EXIT_GRACE_MS='3000'
FIRST_RESPONSE_MS='100'
FOLLOW_UP_US='1000'
INIT_WAIT_US='1000000'
SEED_DIR='in-smtp-replay'
