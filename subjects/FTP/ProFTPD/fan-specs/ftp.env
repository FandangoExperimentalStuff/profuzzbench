# Settings of ftp.fan for this setup: login ubuntu, the session lands in /home/ubuntu, where clean.sh puts test.txt and test/test.txt before every session
FTP_USER='ubuntu'
FTP_PASS='ubuntu'
FTP_FILES='test.txt,test/test.txt,~/test.txt,*.txt'
FTP_DIRS='test,/,.,..,~,-la'
FTP_NEW_NAMES='newdir,renamed.txt,test'
FTP_HELP_ARGS='USER,SITE,RETR,FOO'
FTP_SITE_ARGS='HELP,HELP FOO,UMASK 022,CHMOD 644 test.txt,IDLE 600'
