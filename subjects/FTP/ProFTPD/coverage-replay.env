GCOV_DIR='proftpd-gcov'
GCOV_ROOT='.'
ENDPOINT='tcp://127.0.0.1/21'
SETUP=''
CLEANUP='pkill proftpd; ${WORKDIR}/clean; chown -R ubuntu:ubuntu /home/ubuntu/experiments/proftpd-gcov/src /home/ubuntu/experiments/proftpd-gcov/lib /home/ubuntu/experiments/proftpd-gcov/modules; chmod -R go+rw /home/ubuntu/experiments/proftpd-gcov/src /home/ubuntu/experiments/proftpd-gcov/lib /home/ubuntu/experiments/proftpd-gcov/modules'
SUT='./proftpd -n -c ${WORKDIR}/basic.conf -X'
GCOV_COLLECT=''
KILL_SIGNAL='TERM'
EXIT_GRACE_MS='3000'
FIRST_RESPONSE_MS='1'
FOLLOW_UP_US='1000'
INIT_WAIT_US='1000000'
SEED_DIR='in-ftp-replay'
