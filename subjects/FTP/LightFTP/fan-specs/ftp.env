# Settings of ftp.fan for this setup: login webadmin (fftp.conf), root /home/ubuntu/ftpshare, where clean.sh puts test.txt and test/test.txt before every session
FTP_USER='webadmin'
FTP_PASS='ubuntu'
FTP_FILES='test.txt,test/test.txt,/test.txt,*.txt'
FTP_DIRS='test,/,.,..,-la'
FTP_NEW_NAMES='newdir,renamed.txt,test'
FTP_HELP_ARGS='USER,SITE,RETR,FOO'
FTP_SITE_ARGS='HELP,HELP FOO,CHMOD 644 test.txt,IDLE 600'
