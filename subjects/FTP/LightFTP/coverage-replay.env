GCOV_DIR='LightFTP-gcov/Source/Release'
GCOV_ROOT='..'
ENDPOINT='tcp://127.0.0.1/2200'
SETUP='ftpclean'
CLEANUP='pkill fftp; ftpclean'
SUT='./fftp fftp.conf 2200'
GCOV_COLLECT=''
KILL_SIGNAL='USR1'
EXIT_GRACE_MS='3000'
FIRST_RESPONSE_MS='1'
FOLLOW_UP_US='1000'
INIT_WAIT_US='1000000'
SEED_DIR='in-ftp-replay'
