# Settings of ftp.fan for this setup: login fuzzing, chrooted into /home/fuzzing (pure-ftpd -A), where clean.sh puts test.txt and test/test.txt before every session
FTP_USER='fuzzing'
FTP_PASS='fuzzing'
FTP_FILES='test.txt,test/test.txt,/test.txt,*.txt'
FTP_DIRS='test,/,.,..,-la'
FTP_NEW_NAMES='newdir,renamed.txt,test'
FTP_HELP_ARGS='USER,SITE,RETR,FOO'
FTP_SITE_ARGS='HELP,HELP FOO,CHMOD 644 test.txt,IDLE 600'
# Deviation of PureFTPD the grammar tolerates: the middle lines of its greeting begin with '220-'
TOLERATED='pureftpd_unpadded_mid_line'
