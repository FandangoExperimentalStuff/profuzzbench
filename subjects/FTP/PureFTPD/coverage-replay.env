GCOV_DIR='pure-ftpd-gcov'
GCOV_ROOT='.'
ENDPOINT='tcp://127.0.0.1/21'
SETUP=''
CLEANUP='pkill pure-ftpd; rm -rf /home/fuzzing/test /home/fuzzing/test.txt; mkdir /home/fuzzing/test; echo test > /home/fuzzing/test.txt; echo test > /home/fuzzing/test/test.txt; chmod -R a+rwX /home/fuzzing/test /home/fuzzing/test.txt'
SUT='env GCOV_PREFIX=/home/fuzzing/ src/pure-ftpd -A'
GCOV_COLLECT='cp /home/fuzzing/home/ubuntu/experiments/pure-ftpd-gcov/src/*.gcda /home/ubuntu/experiments/pure-ftpd-gcov/src/ > /dev/null 2>&1'
KILL_SIGNAL='TERM'
EXIT_GRACE_MS='3000'
FIRST_RESPONSE_MS='1'
FOLLOW_UP_US='1000'
INIT_WAIT_US='1000000'
SEED_DIR='in-ftp-replay'
