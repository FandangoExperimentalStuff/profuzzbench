GCOV_DIR='bftpd-gcov'
GCOV_ROOT='.'
ENDPOINT='tcp://127.0.0.1/21'
SETUP='rm -rf /home/ubuntu/ftpshare/* && mkdir /home/ubuntu/ftpshare/data && chmod go+w /home/ubuntu/ftpshare/data && mkdir -p /home/ubuntu/ftpshare/home/ubuntu/experiments/bftpd-gcov/ && chmod -R go+w /home/ubuntu/ftpshare/home && cp ${WORKDIR}/basic.config ${WORKDIR}/basic.config.bak; perl -p -i -e '\''s|AUTO_CHDIR="[^"]*"|AUTO_CHDIR="/data"|'\'' ../basic.conf'
CLEANUP='pkill bftpd; rm -rf /home/ubuntu/ftpshare/data/*; rm -rf /home/ubuntu/ftpshare/data/test /home/ubuntu/ftpshare/data/test.txt; mkdir /home/ubuntu/ftpshare/data/test; echo test > /home/ubuntu/ftpshare/data/test.txt; echo test > /home/ubuntu/ftpshare/data/test/test.txt; chmod -R a+rwX /home/ubuntu/ftpshare/data/test /home/ubuntu/ftpshare/data/test.txt; chown -R ubuntu:ubuntu /home/ubuntu/ftpshare/home; chmod -R go+w /home/ubuntu/ftpshare/home'
SUT='env GCOV_PREFIX=/home/ubuntu/ftpshare ./bftpd -D -c ${WORKDIR}/basic.conf'
GCOV_COLLECT='cp /home/ubuntu/ftpshare/home/ubuntu/experiments/bftpd-gcov/*.gcda /home/ubuntu/experiments/bftpd-gcov/ > /dev/null 2>&1'
KILL_SIGNAL='TERM'
EXIT_GRACE_MS='3000'
FIRST_RESPONSE_MS='1'
FOLLOW_UP_US='1000'
INIT_WAIT_US='1000000'
SEED_DIR='in-ftp-replay'
