# Settings of ftp.fan for this setup: login ubuntu, chrooted into /home/ubuntu/ftpshare, where clean.sh puts test.txt and test/test.txt before every session (the replay starts the session in /data, so the targets are relative)
FTP_USER='ubuntu'
FTP_PASS='ubuntu'
FTP_FILES='test.txt,test/test.txt,*.txt'
FTP_DIRS='test,/,.,..,-la'
FTP_NEW_NAMES='newdir,renamed.txt,test'
FTP_HELP_ARGS='USER,SITE,RETR,FOO'
FTP_SITE_ARGS='HELP,HELP FOO,CHMOD 644 test.txt,IDLE 600'
