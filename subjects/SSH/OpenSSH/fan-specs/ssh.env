# Settings of ssh.fan for this setup: the ubuntu user of the ProFuzzBench image, sshd on port 22 (fandango-run.sh)
SSH_USER=ubuntu
SSH_PASSWORD=ubuntu
SSH_FORWARD_TARGETS=127.0.0.1:22,localhost:9
# Client keys of the spec's verification, mounted with the spec
SSH_CLIENT_KEY_FILE=/home/ubuntu/experiments/fan-specs/keys/client_ed25519
SSH_RSA_KEY_FILE=/home/ubuntu/experiments/fan-specs/keys/client_rsa
SSH_ECDSA_KEY_FILE=/home/ubuntu/experiments/fan-specs/keys/client_ecdsa
SSH_OTHER_RSA_KEY_FILE=/home/ubuntu/experiments/fan-specs/keys/other_rsa
